# Compose interpolation only — public values, not application secrets.
# Application secrets / NEXT_PUBLIC_* live in .env (gitignored).
#
# Local:
#   NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production:
#   DOMAIN=vownests.com
#   NEXT_PUBLIC_BACKEND_URL=https://vownests.com

DOMAIN=vownests.com
CERT_NAME=vownests.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_HOSTS=localhost,127.0.0.1,vownests.com,www.vownests.com

# LETSENCRYPT_DIR=/etc/letsencrypt
# BACKEND_HOST=backend:4000
# FRONTEND_HOST=frontend:3000
